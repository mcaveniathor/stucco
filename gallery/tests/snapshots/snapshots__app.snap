<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" media="(prefers-color-scheme: light)" content="oklch(99.00% 0.0012 250.00)"><meta name="theme-color" media="(prefers-color-scheme: dark)" content="oklch(16.00% 0.0012 250.00)"><title>Application shell</title><script>try {
  const t = localStorage.getItem("stucco-theme");
  if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
} catch (_) {}
</script><link rel="stylesheet" href="/_stucco/stucco.HASH.css"></head><body><div class="st-app-shell"><a class="st-skip-link" href="#main">Skip to main content</a><header class="st-app-header"><div class="st-page-header"><h1 class="st-heading" data-size="3xl">Application shell</h1><div class="st-page-header-description">A server-rendered workspace</div></div></header><div class="st-app-body" data-nav><nav class="st-app-nav" aria-label="Gallery"><a href="index.html">Gallery</a><a href="collections.html">Collections</a></nav><main id="main" class="st-app-main"><section class="st-panel" aria-labelledby="panel-1"><div class="st-panel-header"><h2 id="panel-1" class="st-heading" data-size="lg">Workspace</h2></div><div class="st-page-header"><h3 class="st-heading" data-size="md">Recent activity</h3><div class="st-page-header-description">No recent changes.</div></div></section></main></div><footer class="st-footer">Stucco gallery</footer></div></body></html>
