alue="" selected>Default</option><option value="name">Name</option></select></div><div class="st-collection-control"><label class="st-collection-label" for="direction-1">Direction</label><select id="direction-1" class="st-select" name="dir"><option value="asc" selected>Ascending</option><option value="desc">Descending</option></select></div></div><div class="st-collection-control" data-control="per-page"><label class="st-collection-label" for="per-1">Rows per page</label><select id="per-1" class="st-select" name="per"><option value="10">10</option><option value="25" selected>25</option><option value="50">50</option><option value="100">100</option></select></div><div class="st-collection-actions"><a class="st-button" href="collections.html?per=25" data-variant="ghost" data-size="md">Clear</a><button class="st-button" type="submit" data-variant="primary" data-size="md">Apply filters</button></div></form><div class="st-table-scroll" role="region" aria-label="Customers" tabindex="0"><table class="st-table"><caption>Customers</caption><thead><tr><th scope="col" data-sortable="true"><a href="collections.html?sort=name&amp;dir=asc&amp;per=25">Name</a></th></tr></thead><tbody><tr><td>Ada</td></tr><tr><td>Grace</td></tr></tbody></table></div><div class="st-data-table-footer"><div role="status" aria-live="polite" aria-atomic="true"><p class="st-result-count">Showing 2 results</p></div><nav class="st-pagination" aria-label="Customers pagination"><a href="collections.html?per=25&amp;after=next">Next</a></nav></div></div></div></section><section><div class="st-stack" data-space="4"><h2 class="st-heading" data-size="2xl">Filtered, selectable rows with actions</h2><form id="bulk" class="st-form" method="get" action="collections.html"><div class="st-cluster" data-space="3"><span>With the selected orders:</span><button class="st-button" type="submit" data-variant="secondary" data-size="md" name="action" value="archive">Archive</button></div></form><div class="st-data-table"><form class="st-filter-bar" method="get" action="collections.html"><div class="st-collection-control" data-control="search"><label class="st-collection-label" for="search-2">Search orders</label><input id="search-2" class="st-input" type="search" name="q" value="a" autocomplete="off"></div><div class="st-collection-control"><label class="st-collection-label" for="filter-2">Status</label><select id="filter-2" class="st-select" name="f.status"><option value="">All</option><option value="paid" selected>paid</option></select></div><fieldset class="st-collection-control st-collection-range"><legend class="st-collection-label">Total</legend><div class="st-collection-range-inputs"><label class="st-collection-bound" for="filter-3-min">From</label><input id="filter-3-min" class="st-input" type="number" name="f.total.min" value="50" placeholder="From" step="any"><span class="st-collection-range-sep" aria-hidden="true">–</span><label class="st-collection-bound" for="filter-3-max">To</label><input id="filter-3-max" class="st-input" type="number" name="f.total.max" value="" placeholder="To" step="any"></div></fieldset><div class="st-collection-sort"><div class="st-collection-control"><label class="st-collection-label" for="sort-2">Sort by</label><select id="sort-2" class="st-select" name="sort"><option value="" selected>Default</option><option value="customer">Customer</option><option value="total">Total</option></select></div><div class="st-collection-control"><label class="st-collection-label" for="direction-2">Direction</label><select id="direction-2" class="st-select" name="dir"><option value="asc" selected>Ascending</option><option value="desc">Descending</option></select></div></div><div class="st-collection-control" data-control="per-page"><label class="st-collection-label" for="per-2">Rows per page</label><select id="per-2" class="st-select" name="per"><option value="10">10</option><option value="25" selected>25</option><option value="50">50</option><option value="100">100</opti