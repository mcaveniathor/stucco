<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" media="(prefers-color-scheme: light)" content="oklch(99.00% 0.0012 250.00)"><meta name="theme-color" media="(prefers-color-scheme: dark)" content="oklch(16.00% 0.0012 250.00)"><title>Display &amp; status — stucco gallery</title><script>try {
  const t = localStorage.getItem("stucco-theme");
  if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
} catch (_) {}
</script><link rel="stylesheet" href="/_stucco/stucco.HASH.css"></head><body><a class="st-skip-link" href="#main">Skip to main content</a><main id="main"><div class="st-container g-page" data-size="xl"><div class="st-stack" data-space="10"><div class="st-stack" data-space="3"><a class="st-link" href="index.html">← Gallery</a><h1 class="st-heading" data-size="3xl">Display &amp; status</h1><p class="st-text" data-size="lg" data-tone="muted">Badges, avatars, details, stats, where-you-are navigation, progress, callouts and disclosure, all without script.</p></div><section><div class="st-stack" data-space="4"><h2 class="st-heading" data-size="2xl">Badge</h2><div class="st-cluster" data-space="3"><span class="st-badge" data-tone="default">Draft</span><span class="st-badge" data-tone="muted">Archived</span><span class="st-badge" data-tone="accent">New</span><span class="st-badge" data-tone="info">Paid</span><span class="st-badge" data-tone="success">Shipped</span><span class="st-badge" data-tone="warning">Pending</span><span class="st-badge" data-tone="danger">Overdue</span><span class="st-badge" data-tone="success"><svg class="st-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="m16 9-5.5 5.5L8 12" /></svg>Verified</span><span class="st-badge" data-tone="default">Bartholomew Montgomery-Fitzwilliam Hargreaves the Third, Esq.</span><span class="st-badge" data-tone="default">ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz01234567</span></div></div></section><section><div class="st-stack" data-space="4"><h2 class="st-heading" data-size="2xl">Avatar</h2><div class="st-cluster" data-space="3"><span class="st-avatar" data-size="sm" role="img" aria-label="Ada Lovelace"><span class="st-avatar-initials" aria-hidden="true">AL</span></span><span class="st-avatar" data-size="md" role="img" aria-label="Grace Hopper"><span class="st-avatar-initials" aria-hidden="true">GH</span></span><span class="st-avatar" data-size="lg" role="img" aria-label="Alan Turing"><span class="st-avatar-initials" aria-hidden="true">AT</span></span><span class="st-avatar" data-size="md"><span class="st-avatar-initials" aria-hidden="true">KJ</span><img src="avatar.svg" alt="Katherine Johnson"></span><div class="st-cluster" data-space="3"><span class="st-avatar" data-size="md" aria-hidden="true"><span class="st-avatar-initials" aria-hidden="true">AL</span></span><span class="st-text" data-size="md">Ada Lovelace</span></div></div></div></section><section><div class="st-stack" data-space="4"><h2 class="st-heading" data-size="2xl">Description list</h2><dl class="st-dl"><div class="st-dl-item"><dt>Customer</dt><dd>Ada Lovelace</dd></div><div class="st-dl-item"><dt>Status</dt><dd><span class="st-badge" data-tone="info">Paid</span></dd></div><div class="st-dl-item"><dt>Total</dt><dd>$12.50</dd></div><div class="st-dl-item"><dt>Notes</dt><dd>Bartholomew Montgomery-Fitzwilliam Hargreaves the Third, Esq.</dd></div></dl></div></section><section><div class="st-stack" data-space="4"><h2 class="st-heading" data-size="2xl">Stat</h2><div class="st-grid" data-min="xs" data-space="6"><div class="st-stat"><p class="st-stat-label">Revenue</p><p class="st-stat-value">$12,400</p><p class="st-stat-change"><span class="st-stat-delta" data-tone="success" data-trend="up"><svg class="st-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12 7-7 7 7" /><path d="M12 19V5" /></svg><span class="st-sr-only">Up </span>12%</span> vs last week</p></div><div class="st-stat"><p class="st-stat-label">Refunds</p><p class="st-stat-value">18</p><p class="st-stat-change"><span class="st-stat-delta" data-tone="danger" data-trend="up"><svg class="st-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12 7-7 7 7" /><path d="M12 19V5" /></svg><span class="st-sr-only">Up </span>4</span> vs last week</p></div><div class="st-stat"><p class="st-stat-label">Open orders</p><p class="st-stat-value">42</p><p class="st-stat-change"><span class="st-stat-delta" data-tone="default" data-trend="flat"><svg class="st-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14" /></svg><span class="st-sr-only">No change </span>0%</span></p></div><div class="st-stat"><p class="st-stat-label">Average basket</p><p class="st-stat-value">$31.20</p><p class="st-stat-change"><span class="st-stat-delta" data-tone="default" data-trend="down"><svg class="st-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14" /><path d="m19 12-7 7-7-7" /></svg><span class="st-sr-only">Down </span>2%</span></p></div></div></div></section><section><div class="st-stack" data-space="4"><h2 class="st-heading" data-size="2xl">Breadcrumbs</h2><div class="st-stack" data-space="4"><nav class="st-breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="#orders">Orders</a></li><li><a href="#order">Order 42</a></li><li><span aria-current="page">Edit</span></li></ol></nav><nav class="st-breadcrumbs" aria-label="Customer location"><ol><li><a href="#customers">Customers</a></li><li><span aria-current="page">Bartholomew Montgomery-Fitzwilliam Hargreaves the Third, Esq.</span></li></ol></nav><nav class="st-breadcrumbs" aria-label="Unbroken location"><ol><li><a href="#customers">Customers</a></li><li><span aria-current="page">ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz01234567</span></li></ol></nav></div></div></section><section><div class="st-stack" data-space="4"><h2 class="st-heading" data-size="2xl">Steps</h2><div class="st-stack" data-space="4"><nav class="st-steps" aria-label="Checkout"><ol><li data-state="done"><span class="st-steps-marker" aria-hidden="true">1</span><a href="#cart">Cart<span class="st-sr-only"> (completed)</span></a></li><li data-state="done"><span class="st-steps-marker" aria-hidden="true">2</span><span>Account<span class="st-sr-only"> (completed)</span></span></li><li data-state="current"><span class="st-steps-marker" aria-hidden="true">3</span><span aria-current="step">Shipping</span></li><li data-state="todo"><span class="st-steps-marker" aria-hidden="true">4</span><span>Payment<span class="st-sr-only"> (not started)</span></span></li></ol></nav><nav class="st-steps" aria-label="Unbroken steps"><ol><li data-state="current"><span class="st-steps-marker" aria-hidden="true">1</span><span aria-current="step">ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz01234567</span></li><li data-state="todo"><span class="st-steps-marker" aria-hidden="true">2</span><span>Finish<span class="st-sr-only"> (not started)</span></span></li></ol></nav></div></div></section><section><div class="st-stack" data-space="4"><h2 class="st-heading" data-size="2xl">Progress and meter</h2><div class="st-stack" data-space="4"><div class="st-progress"><label for="progress-1">Import</label><progress id="progress-1" value="42" max="100">42%</progress><span class="st-progress-value">42%</span></div><div class="st-progress"><label for="progress-2">Uploading</label><progress id="progress-2"></progress></div><div class="st-meter"><label for="meter-1">Storage</label><meter id="meter-1" value="7.2" min="0" max="10" low="3" high="8" optimum="1" aria-describedby="metertext-1">7.2</meter><span id="metertext-1" class="st-meter-text">7.2 of 10 GB</span></div><div class="st-meter"><label for="meter-2">Battery</label><meter id="meter-2" value="0.9" min="0" max="1" low="0.2" high="0.8" optimum="1" aria-describedby="metertext-2">0.9</meter><span id="metertext-2" class="st-meter-text">90%</span></div></div></div></section><section><div class="st-stack" data-space="4"><h2 class="st-heading" data-size="2xl">Callout</h2><div class="st-stack" data-space="4"><div class="st-callout" data-tone="warning"><svg class="st-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" /><path d="M12 9v4" /><path d="M12 17h.01" /></svg><div class="st-callout-body"><p class="st-callout-title"><span class="st-sr-only">Warning: </span>Payment overdue</p><p class="st-text" data-size="md">Invoice 1042 was due on 1 October.</p><div class="st-callout-actions"><a class="st-button" href="#pay" data-variant="secondary" data-size="md">Pay now</a></div></div></div><div class="st-callout" data-tone="info"><svg class="st-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg><div class="st-callout-body"><p class="st-callout-title"><span class="st-sr-only">Note: </span>Prices change on 1 November</p></div></div><div class="st-callout" data-tone="success"><svg class="st-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="m16 9-5.5 5.5L8 12" /></svg><div class="st-callout-body"><p class="st-callout-title"><span class="st-sr-only">Success: </span>Your export is ready</p></div></div><div class="st-callout" data-tone="danger"><svg class="st-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><line x1="12" x2="12" y1="8" y2="12" /><line x1="12" x2="12.01" y1="16" y2="16" /></svg><div class="st-callout-body"><p class="st-callout-title"><span class="st-sr-only">Important: </span>This order can't be shipped</p><p class="st-text" data-size="md">Bartholomew Montgomery-Fitzwilliam Hargreaves the Third, Esq.</p></div></div><div class="st-callout" data-tone="accent"><svg class="st-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg><div class="st-callout-body"><span class="st-sr-only">Note: </span><p class="st-text" data-size="md">A note in the accent colour.</p></div></div><div class="st-callout" data-tone="default"><svg class="st-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg><div class="st-callout-body"><p class="st-callout-title">A neutral note</p></div></div></div></div></section><section><div class="st-stack" data-space="4"><h2 class="st-heading" data-size="2xl">Disclosure</h2><div class="st-stack" data-space="4"><details class="st-disclosure"><summary><h3>Shipping details</h3><svg class="st-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg></summary><div class="st-disclosure-body"><p class="st-text" data-size="md">Courier, two working days.</p></div></details><details class="st-disclosure"><summary><span>Bartholomew Montgomery-Fitzwilliam Hargreaves the Third, Esq.</span><svg class="st-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg></summary><div class="st-disclosure-body"><p class="st-text" data-size="md">Long summaries wrap.</p></div></details></div></div></section><section><div class="st-stack" data-space="4"><h2 class="st-heading" data-size="2xl">Accordion</h2><div class="st-accordion"><details class="st-disclosure" name="accordion-1" open><summary><h3>How long does delivery take?</h3><svg class="st-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg></summary><div class="st-disclosure-body"><p class="st-text" data-size="md">Two working days.</p></div></details><details class="st-disclosure" name="accordion-1"><summary><h3>Can I return an order?</h3><svg class="st-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg></summary><div class="st-disclosure-body"><p class="st-text" data-size="md">Within 30 days.</p></div></details><details class="st-disclosure" name="accordion-1"><summary><h3>Do you ship abroad?</h3><svg class="st-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg></summary><div class="st-disclosure-body"><p class="st-text" data-size="md">To most of Europe.</p></div></details></div></div></section></div></div></main></body></html>
