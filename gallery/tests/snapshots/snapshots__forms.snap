<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Forms — stucco gallery</title><script>try {
  const t = localStorage.getItem("stucco-theme");
  if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
} catch (_) {}
</script><link rel="stylesheet" href="/_stucco/stucco.HASH.css"></head><body><a class="st-skip-link" href="#main">Skip to main content</a><main id="main"><div class="st-container g-page" data-size="xl"><div class="st-stack" data-space="10"><div class="st-stack" data-space="3"><a class="st-link" href="index.html">← Gallery</a><h1 class="st-heading" data-size="3xl">Forms</h1><p class="st-text" data-size="lg" data-tone="muted">Fields wire labels, hints and errors automatically and redisplay submitted values — never passwords.</p></div><section><div class="st-stack" data-space="4"><h2 class="st-heading" data-size="2xl">A submitted form with errors</h2><form class="st-form" method="post" action="#"><input type="hidden" name="_csrf" value="demo-token"><div class="st-stack" data-space="6"><div class="st-grid" data-min="xs" data-space="4"><div class="st-field"><label class="st-label" for="field-1">Name<span class="st-required" aria-hidden="true">*</span></label><input id="field-1" class="st-input" type="text" name="name" value="Ada Lovelace" autocomplete="name" required></div><div class="st-field"><label class="st-label" for="field-2">Email</label><input id="field-2" class="st-input" type="email" name="email" value="ada@example" autocomplete="email" aria-describedby="field-2-hint field-2-error" aria-invalid="true"><p id="field-2-hint" class="st-field-hint">We only use it for receipts.</p><p id="field-2-error" class="st-field-error"><span class="st-sr-only">Error: </span>Enter a valid email address.</p></div><div class="st-field"><label class="st-label" for="field-3">Password</label><input id="field-3" class="st-input" type="password" name="password" autocomplete="new-password" aria-describedby="field-3-hint"><p id="field-3-hint" class="st-field-hint">At least 12 characters.</p></div><div class="st-field"><label class="st-label" for="field-4">Website</label><div class="st-input-group"><span class="st-input-adornment">https://</span><input id="field-4" class="st-input" type="url" name="website"></div></div><div class="st-field"><label class="st-label" for="field-5">Quantity</label><div class="st-input-group"><input id="field-5" class="st-input" type="number" name="quantity" min="1"><span class="st-input-adornment">seats</span></div></div><div class="st-field"><label class="st-label" for="field-6">Plan</label><select id="field-6" class="st-select" name="plan"><option value="" disabled>Choose a plan…</option><option value="solo">Solo</option><option value="team" selected>Team</option><option value="enterprise">Enterprise</option></select></div></div><div class="st-field"><label class="st-label" for="field-7">Bio</label><textarea id="field-7" class="st-textarea" name="bio" rows="3"></textarea></div><fieldset class="st-fieldset"><legend class="st-legend">Preferences</legend><div class="st-stack" data-space="4"><fieldset class="st-radio-group" aria-describedby="radios-1-error" aria-invalid="true"><legend class="st-legend">Billing</legend><label class="st-radio"><input type="radio" name="billing" value="monthly">Monthly</label><label class="st-radio"><input type="radio" name="billing" value="yearly">Yearly</label><p id="radios-1-error" class="st-field-error"><span class="st-sr-only">Error: </span>Choose a billing period.</p></fieldset><label class="st-checkbox"><input type="checkbox" name="terms" value="on" checked>I agree to the terms</label></div></fieldset><div class="st-cluster" data-space="3"><button class="st-button" type="submit" data-variant="primary" data-size="md">Create account</button><button class="st-button" type="reset" data-variant="secondary" data-size="md">Reset</button></div></div></form></div></section></div></div></main></body></html>
